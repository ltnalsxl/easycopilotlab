{%- assign empty_array = "" | split: "" -%}
<ul class="nav-list">{%- for node in include.pages -%}
    {%- assign nav_children = include.all_pages
          | where_exp: "item", "item.title != nil"
          | where_exp: "item", "item.nav_exclude != true"
          | where: "parent", node.title -%}
    {%- include components/nav/sorted.html pages=nav_children -%}
    {%- assign nav_children = nav_sorted | default: empty_array -%}
    {%- assign branch_active = include.current_ancestors contains node.title -%}
    {%- assign node_active = page.url == node.url -%}
    {%- assign node_expanded = false -%}
    {%- if branch_active or node_active -%}
      {%- assign node_expanded = true -%}
    {%- endif -%}
    <li class="nav-list-item{% if node_expanded %} active{% endif %}">
      {%- if nav_children.size >= 1 -%}
        <button class="nav-list-expander btn-reset" aria-label="{{ node.title }} submenu" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><use xlink:href="#svg-arrow-right"></use></svg>
        </button>
      {%- endif -%}
      <a href="{{ node.url | relative_url }}" class="nav-list-link{% if node_active %} active{% endif %}">{{ node.title }}</a>
      {%- if nav_children.size >= 1 -%}
        {%- if node.child_nav_order == 'desc' or node.child_nav_order == 'reversed' -%}
          {%- assign nav_children = nav_children | reverse -%}
        {%- endif -%}
        {%- include components/course_switcher_links.liquid pages=nav_children all_pages=include.all_pages current_ancestors=include.current_ancestors -%}
      {%- endif -%}
    </li>{%- endfor -%}</ul>